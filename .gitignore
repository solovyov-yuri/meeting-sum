# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data files — keep folder structure, ignore content
data/*
!data/.gitkeep

# Test and build artifacts
.pytest_cache/
.tmp/

# Local config (contains secrets / personal paths)
config.yaml
# Ignore only machine-local Claude settings. Permissions (the command allowlist and the deny on
# `uv`, which corrupts the Windows venv) deliberately live in that local file, not in a shared
# settings.json — so a fresh clone starts with no inherited permissions. Project skills, if any,
# can still be versioned here; the project-review skill itself lives globally.
.claude/settings.local.json
