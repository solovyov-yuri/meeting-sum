# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data files — keep folder structure, ignore content
data/*
!data/.gitkeep

# Test and build artifacts
.pytest_cache/
.tmp/

# Local config (contains secrets / personal paths)
config.yaml
# Ignore only machine-local Claude settings; a shared .claude/settings.json (and any
# project skills) can be versioned. The project-review skill itself lives globally (AGENT-001).
.claude/settings.local.json
